pipeline {
    agent any

    stages {
        stage('Code Analysis') {
            steps {
                echo 'Checking HTML syntax...'
                // On Linux/Mac, this checks if the file exists and has content
                sh 'test -s index.html' 
                echo 'HTML file looks good.'
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo 'Saving the website files...'
                // This saves the HTML in Jenkins so you can download it later
                archiveArtifacts artifacts: 'index.html', fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying to Web Server...'
                // Example: Copying to a local web directory (like Apache or Nginx)
                // sh 'cp index.html /var/www/html/'
                echo 'Application is live!'
            }
        }
    }
}
